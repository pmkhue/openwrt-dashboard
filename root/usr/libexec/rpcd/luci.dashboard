#!/bin/sh
# rpcd ubus provider for luci-app-dashboard
# Implements ubus object: luci.dashboard
# Compatible with POSIX sh and BusyBox ash

CACHE_DIR="${CACHE_DIR:-/tmp/dashboard}"

method_system_info() {
	if [ -s "$CACHE_DIR/system.json" ]; then
		cat "$CACHE_DIR/system.json"
	else
		cat <<EOF
{
  "hostname": "OpenWrt",
  "model": "OpenWrt Device",
  "build": "OpenWrt",
  "kernel": "unknown",
  "uptime": 0,
  "cpu": { "percent": 0.0, "load": [0.0, 0.0, 0.0], "cores": 1 },
  "memory": { "total_kb": 0, "used_kb": 0, "percent": 0.0 },
  "disk": { "total_kb": 0, "used_kb": 0, "percent": 0.0 },
  "temp": { "celsius": null, "available": false }
}
EOF
	fi
}

method_traffic() {
	if [ -s "$CACHE_DIR/traffic.json" ]; then
		cat "$CACHE_DIR/traffic.json"
	else
		cat <<EOF
{
  "rx_bps": 0,
  "tx_bps": 0,
  "rx_total_bytes": 0,
  "tx_total_bytes": 0,
  "history": []
}
EOF
	fi
}

method_processes() {
	# Read parameters from STDIN
	input=$(cat)
	limit=""
	sort_key=""

	if [ -n "$input" ]; then
		if command -v jsonfilter >/dev/null 2>&1; then
			limit=$(printf '%s' "$input" | jsonfilter -e '@.limit' 2>/dev/null)
			sort_key=$(printf '%s' "$input" | jsonfilter -e '@.sort' 2>/dev/null)
		fi
		if [ -z "$limit" ] || [ -z "$sort_key" ]; then
			parsed_params=$(printf '%s' "$input" | awk '
				function extract_val(str, key) {
					regex = "\"" key "\"[ \t]*:[ \t]*";
					if (match(str, regex)) {
						tail = substr(str, RSTART + RLENGTH);
						if (substr(tail, 1, 1) == "\"") {
							sub(/^"/, "", tail);
							idx = index(tail, "\"");
							return substr(tail, 1, idx - 1);
						} else {
							sub(/^[ \t]*/, "", tail);
							len = length(tail);
							for (idx = 1; idx <= len; idx++) {
								ch = substr(tail, idx, 1);
								if (ch == "," || ch == "}" || ch == " " || ch == "\t" || ch == "\r" || ch == "\n") break;
							}
							return substr(tail, 1, idx - 1);
						}
					}
					return "";
				}
				{ str = str $0 }
				END {
					printf "%s\t%s\n", extract_val(str, "limit"), extract_val(str, "sort");
				}
			')
			tab="$(printf '\t')"
			old_ifs="$IFS"
			IFS="$tab"
			read -r p_limit p_sort <<EOF
$parsed_params
EOF
			IFS="$old_ifs"
			[ -z "$limit" ] && limit="$p_limit"
			[ -z "$sort_key" ] && sort_key="$p_sort"
		fi
	fi

	case "$limit" in
		''|*[!0-9]*) limit=30 ;;
	esac
	case "$sort_key" in
		cpu|net|mem) ;;
		*) sort_key="mem" ;;
	esac

	proc_file="$CACHE_DIR/processes.json"
	if [ ! -s "$proc_file" ]; then
		printf '{\n  "processes": []\n}\n'
		return 0
	fi

	awk -v limit="$limit" -v sort_key="$sort_key" '
		function extract_val(str, key) {
			regex = "\"" key "\"[ \t]*:[ \t]*";
			if (match(str, regex)) {
				tail = substr(str, RSTART + RLENGTH);
				if (substr(tail, 1, 1) == "\"") {
					sub(/^"/, "", tail);
					idx = index(tail, "\"");
					return substr(tail, 1, idx - 1);
				} else {
					sub(/^[ \t]*/, "", tail);
					len = length(tail);
					for (idx = 1; idx <= len; idx++) {
						ch = substr(tail, idx, 1);
						if (ch == "," || ch == "}" || ch == " " || ch == "\t" || ch == "\r" || ch == "\n") break;
					}
					return substr(tail, 1, idx - 1);
				}
			}
			return "";
		}

		BEGIN {
			count = 0;
		}

		{
			line = $0;
			if (match(line, /"pid"[ \t]*:[ \t]*[0-9]+/)) {
				p_pid = extract_val(line, "pid");
				p_name = extract_val(line, "name");
				p_cpu = extract_val(line, "cpu_percent");
				p_mem = extract_val(line, "mem_kb");
				p_net = extract_val(line, "net_bps");
				p_app = extract_val(line, "net_approx");

				item_pid[count] = p_pid;
				item_name[count] = p_name;
				item_cpu[count] = p_cpu + 0.0;
				item_mem[count] = p_mem + 0;
				item_net[count] = (p_net == "null" || p_net == "") ? 0 : p_net + 0;
				item_net_raw[count] = (p_net == "" ? "null" : p_net);
				item_app[count] = (p_app == "" ? "true" : p_app);
				indices[count] = count;
				count++;
			}
		}

		END {
			if (count == 0) {
				printf "{\n  \"processes\": []\n}\n";
				exit 0;
			}

			# Insertion sort descending
			for (i = 1; i < count; i++) {
				key_idx = indices[i];
				j = i - 1;
				while (j >= 0) {
					curr_idx = indices[j];
					val_j = (sort_key == "cpu") ? item_cpu[curr_idx] : ((sort_key == "net") ? item_net[curr_idx] : item_mem[curr_idx]);
					val_key = (sort_key == "cpu") ? item_cpu[key_idx] : ((sort_key == "net") ? item_net[key_idx] : item_mem[key_idx]);
					if (val_j < val_key) {
						indices[j + 1] = indices[j];
						j--;
					} else {
						break;
					}
				}
				indices[j + 1] = key_idx;
			}

			max_items = (limit > 0 && limit < count) ? limit : count;
			printf "{\n  \"processes\": [\n";
			first = 1;
			for (i = 0; i < max_items; i++) {
				idx = indices[i];
				if (!first) printf ",\n";
				first = 0;
				printf "    { \"pid\": %d, \"name\": \"%s\", \"cpu_percent\": %.1f, \"mem_kb\": %d, \"net_bps\": %s, \"net_approx\": %s }", \
					item_pid[idx], item_name[idx], item_cpu[idx], item_mem[idx], item_net_raw[idx], item_app[idx];
			}
			printf "\n  ]\n}\n";
		}
	' "$proc_file"
}

method_clients() {
	if [ -s "$CACHE_DIR/clients.json" ]; then
		cat "$CACHE_DIR/clients.json"
	else
		printf '{\n  "clients": []\n}\n'
	fi
}

method_ports() {
	if [ -s "$CACHE_DIR/ports.json" ]; then
		cat "$CACHE_DIR/ports.json"
	else
		printf '{\n  "ports": []\n}\n'
	fi
}

case "$1" in
	list)
		cat <<EOF
{
  "system_info": {},
  "traffic": {},
  "processes": { "limit": 0, "sort": "" },
  "clients": {},
  "ports": {}
}
EOF
		;;
	call)
		case "$2" in
			system_info) method_system_info ;;
			traffic) method_traffic ;;
			processes) method_processes ;;
			clients) method_clients ;;
			ports) method_ports ;;
			*)
				return 1 2>/dev/null || exit 1
				;;
		esac
		;;
	*)
		return 1 2>/dev/null || exit 1
		;;
esac
